{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.1.0",
  "description": "High-Concurrency Headless E-Commerce Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "npm run db:migrate -w @ecommerce/api",
    "db:generate": "npm run db:generate -w @ecommerce/api",
    "db:seed": "npm run db:seed -w @ecommerce/api",
    "db:studio": "npm run db:studio -w @ecommerce/api",
    "boot": "npm install && docker compose up -d && timeout /t 10 /nobreak && npm run db:migrate && npm run db:seed && concurrently \"npm run dev\" \"stripe listen --forward-to localhost:5000/api/v1/webhooks\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.9.6"
  }
}
